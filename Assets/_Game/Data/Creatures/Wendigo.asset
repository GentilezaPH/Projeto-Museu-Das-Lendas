  m_Script: {fileID: 11500000, guid: 6e632104c6a7d654e8b3241ab2ab644e, type: 3}
  m_Name: Wendigo
  m_EditorClassIdentifier: Assembly-CSharp::CreatureData
  creatureName: Wendigo
  habitatDescription: "Florestas frias do Canad\xE1 e norte dos EUA \u2014 sempre
    associado a neve, pinheiros e lagos congelados."
  behaviorDescription: "Extremamente agressivo, silencioso e paciente. Persegue por
    horas e ataca ao perceber fraqueza. Age como um ca\xE7ador, n\xE3o como um animal."
  styleMonster: "Terror e sobreviv\xEAncia: press\xE3o constante para reunir evid\xEAncias
    e sair antes que a ca\xE7ada fique intensa demais."
  agressivenessLevel: 4
  possibleEvidences: 030000000100000002000000
  suggestedTrap: 1
  weaknessOrBait: "Sem consenso no folclore. Sugerimos fogo, rituais espirituais,
    ou um objeto pessoal ligado \xE0 humanidade perdida como isca tem\xE1tica."
  uniqueMechanicNotes: "Sistema de fases de persegui\xE7\xE3o (observa \u2192 cerca
    \u2192 aparece rapidamente \u2192 ataca) combinado com um medidor de paranoia
    que sobe com o tempo na floresta, tornando a criatura mais ousada e os equipamentos
    menos confi\xE1veis."
  folkloreNotes: "Figura espiritual dos povos algonquinos ligada \xE0 gan\xE2ncia
    e \xE0 perda da humanidade. Vale preservar essa camada moral al\xE9m do terror
    puro."
